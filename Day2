public class table {
    public static void main(String[] args) {

        System.out.println("EVEN TABLES");

        for(int i=1; i<=40; i++) {
            if(i%2==0) {
                for(int j=1; j<=10; j++) {
                    System.out.println(i+"*"+j+"="+(i*j));
                }
                System.out.println("The "+i+" table is ended");
            }
        }

        System.out.println("\nODD TABLES");

        for(int i=1; i<=40; i++) {
            if(i%2!=0) {
                for(int j=1; j<=10; j++) {
                    System.out.println(i+"*"+j+"="+(i*j));
                }
                System.out.println("The "+i+" table is ended");
            }
        }
    }
